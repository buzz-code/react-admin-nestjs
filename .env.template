DOMAIN_NAME=demo.yoman.online
# Set only for local/dev CORS matching against a raw IP (e.g. http://192.168.1.5:3000).
# Leave blank in normal deployments.
IP_ADDRESS=
NODE_ENV=production
PORT=3000
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password
MYSQL_DATABASE=mysql_database
MYSQL_ROOT_PASSWORD=mysql_root_password
JWT_SECRET=jwt_secret
ADMIN_USER=admin_user:admin_password
SMTP_USER=user
SMTP_PASSWORD=password

# Maintenance Mode (Server-side, auto-detected by frontend)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=המערכת בתחזוקה תכנונית. אנא נסו שוב מאוחר יותר.

# Enables the background job worker + schedule heartbeat (recurring jobs like
# attendance-cleanup-sweep) on this server instance. Defaults to true for the
# common single-container deployment. If ever running multiple server
# replicas, keep this true on only one of them (or a dedicated worker
# instance) - the heartbeat isn't safe to double-fire.
WORKER_ENABLED=true
# Job worker polling. Optional, defaults to 5000ms / batch of 5 if unset.
JOB_POLL_MS=5000
JOB_WORKER_BATCH=5

# Optional: require this shared secret on inbound mail-webhook requests.
# Leave blank to accept webhook calls without a secret check.
MAIL_WEBHOOK_SECRET=

# Optional: Yemot legacy route cutover deadline (ISO date). Leave blank if unused.
YEMOT_LEGACY_ROUTE_DEADLINE=

# Optional: S3-compatible storage for user-data-export files. Leave blank to disable.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

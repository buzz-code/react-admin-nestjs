DOMAIN_NAME=demo.yoman.online
MYSQL_HOST=database
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password
MYSQL_DATABASE=mysql_database
MYSQL_ROOT_PASSWORD=mysql_root_password	
JWT_SECRET=jwt_secret
ADMIN_USER=admin_user:admin_password
SMTP_USER=user
SMTP_PASSWORD=password

# Maintenance Mode (Server-side, auto-detected by frontend)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=המערכת בתחזוקה תכנונית. אנא נסו שוב מאוחר יותר.

# Enables the background job worker + schedule heartbeat (recurring jobs like
# attendance-cleanup-sweep) on this server instance. Defaults to true for the
# common single-container deployment. If ever running multiple server
# replicas, keep this true on only one of them (or a dedicated worker
# instance) - the heartbeat isn't safe to double-fire.
WORKER_ENABLED=true

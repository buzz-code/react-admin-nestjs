DOMAIN_NAME=demo.yoman.online
MYSQL_HOST=database
MYSQL_USER=mysql_user
MYSQL_PASSWORD=mysql_password
MYSQL_DATABASE=mysql_database
MYSQL_ROOT_PASSWORD=mysql_root_password	
JWT_SECRET=jwt_secret
ADMIN_USER=admin_user:admin_password
SMTP_USER=user
SMTP_PASSWORD=password

# Maintenance Mode (Server-side, auto-detected by frontend)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=המערכת בתחזוקה תכנונית. אנא נסו שוב מאוחר יותר.

# Inbound-mail webhook (handle-email), checked against X-Webhook-Secret header. Unset = guard is a no-op.
MAIL_WEBHOOK_SECRET=

# Optional: sunset date for the legacy, unauthenticated /yemot/handle-call URL. Unset = no cutoff.
YEMOT_LEGACY_ROUTE_DEADLINE=
